<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- 通常の lib/ 参照としてではなく、analyzers/ 配下にのみ配置する -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>NU5128</NoWarn>

    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>VbNamespaceAnalyzer</PackageId>
    <Version>1.0.0</Version>
    <Authors>Takiru</Authors>
    <Description>VB.NET のファイルの名前空間がフォルダー構造 + RootNamespace と一致するかを検証するRoslynアナライザー</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.14.0" />
  </ItemGroup>

  <!-- ここが重要: ビルド成果物を analyzers/dotnet/vb に配置する指定 -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/vb" Visible="false" />
  </ItemGroup>
</Project>
